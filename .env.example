# Use separate non-production Supabase configuration for local testing.
# Browser-visible publishable key only; never use a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project

# ── Pagamentos (checkout REJENDARI) ──────────────────────────────
# Stripe: cartões (Visa/Mastercard), Apple Pay, Google Pay e PayPal.
# Test keys começam por pk_test_ / sk_test_ — usa-as primeiro.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Ativa o método PayPal na Stripe (o método exige ativação na conta Stripe primeiro).
VITE_STRIPE_PAYPAL_ENABLED=false
# Webhook (Supabase Edge Function `stripe-webhook`): segredo whsec_ da Stripe
# + SUPABASE_SERVICE_ROLE_KEY como secret do projeto.
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# MB WAY via ifthenpay (fase 3): as chaves chegam com o contrato.
# VITE_IFTHENPAY_ENABLED=false
# IFTHENPAY_API_KEY=

# Crypto via Coinbase Commerce (fase 3).
# VITE_COINBASE_ENABLED=false
# COINBASE_COMMERCE_API_KEY=
